# Scout runtime
SCOUT_ENV=development
SCOUT_PUBLIC_BASE_URL=http://localhost:8000

# ---------------------------------------------------------------------------
# Live AI engine (OllaBridge Cloud by default)
# Scout asks an OpenAI-compatible gateway to design each user's
# study -> build -> publish path. Defaults below work with no API key.
# Admins can also change these at runtime from /dashboard/admin.html.
# ---------------------------------------------------------------------------
SCOUT_AI_ENABLED=1
SCOUT_AI_PROVIDER=OllaBridge Cloud
# Space: https://huggingface.co/spaces/ruslanmv/ollabridge
# The line below is that Space's direct API endpoint. You may also paste the
# Space page URL above and Scout auto-resolves it to the endpoint.
SCOUT_AI_BASE_URL=https://ruslanmv-ollabridge.hf.space/v1
SCOUT_AI_MODEL=free-best
# Leave blank for the public gateway; set a key to use premium providers.
# The OllaBridge API key can be supplied under any of these names (SCOUT_AI_API_KEY
# wins if several are set): SCOUT_AI_API_KEY, SCOUT_LLM_API_KEY, OB_TOKEN.
# Keep the real value in a local .env (gitignored) or a CI/deploy secret — never
# commit it. If a key was ever pasted in plaintext, rotate it in the OllaBridge
# dashboard.
SCOUT_AI_API_KEY=
OB_TOKEN=
SCOUT_AI_TEMPERATURE=0.4
SCOUT_AI_TIMEOUT=45
SCOUT_AI_MAX_TOKENS=900

# Admin-only Settings page. Set a secret to unlock /dashboard/admin.html.
# If unset, the admin area stays locked (recommended default for public deploys).
SCOUT_ADMIN_KEY=
# Where runtime admin overrides are persisted (gitignored).
SCOUT_RUNTIME_CONFIG=runtime/settings.json

# Optional model enrichment. The system works without these.
SCOUT_ENABLE_LLM=0
SCOUT_LLM_PROVIDER=deterministic
SCOUT_DESCRIPTION_MODEL=template-v1
SCOUT_USE_SENTENCE_TRANSFORMERS=0
SCOUT_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Optional external source credentials
GITHUB_TOKEN=
HF_TOKEN=
HF_DATASET_REPO=ruslanmv/scout-data
NEWS_API_KEY=
JOBS_API_KEY=

# Learning Navigator — real course discovery (Udemy / Coursera / web).
# Priority: TAVILY_API_KEY > BRAVE_API_KEY > keyless DuckDuckGo. With a key,
# discovery activates automatically. For a keyless (best-effort) fallback set
# SCOUT_ENABLE_WEB_DISCOVERY=1. With none set, Scout uses its offline static
# catalog only. Discovered courses are tagged with the searched skill, priced as
# "Verify on provider", and — when the learner lists a marketplace in
# preferred_providers — become the primary recommendation with the free official
# resource kept as the alternative.
TAVILY_API_KEY=
BRAVE_API_KEY=
SCOUT_ENABLE_WEB_DISCOVERY=0
# Optional: force a specific backend, e.g. duckduckgo
SCOUT_WEB_SEARCH=

# Publishing
SCOUT_PUBLISH_HF=0
