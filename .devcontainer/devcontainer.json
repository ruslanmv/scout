{
  "name": "Scout — API & dashboard",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  "postCreateCommand": "python -m pip install -r requirements.txt && python scripts/generate_snapshot.py",
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": {
      "label": "Scout API + browser demo",
      "onAutoForward": "notify"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python"]
    }
  }
}
